<launch>
  <!-- Pass a world filename from the package's `worlds/` directory, e.g. "docking.world" or "whycode_1.world" -->
  <arg name="world" default="docking.world"/>
  <!-- <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find whycode_sim)/worlds/whycode_$(arg world).world"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="true"/>
    <arg name="headless" value="false"/>
    <arg name="debug" value="false"/>
  </include> -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <!-- Use the `world` argument as the filename under the package's `worlds/` folder -->
    <arg name="world_name" value="$(find whycode_sim)/worlds/$(arg world)"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="true"/>
    <arg name="headless" value="false"/>
    <arg name="debug" value="false"/>
  </include>

  <!-- Spawn a robot into Gazebo (use unique model name to avoid collisions) -->
  <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model" args="-file $(find whycode_sim)/urdf/camera.urdf -urdf -model camera" />

</launch>
