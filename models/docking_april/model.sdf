<?xml version='1.0'?>
<sdf version='1.9'>
  <model name='docking_april'>
    <link name='base_link'>
      <pose>0 0 0.1 0 3.14 0</pose>

      <!-- Base plates for the docking station (two narrow plates left/right).
           Each plate is a box 0.1 x 1.2 x 0.05 m. Poses place them at x = -0.4 and x = +0.4
           relative to this link origin. Materials use Gazebo gray scripts. -->
      <visual name='base_plate_visual'>
        <pose>-0.4 0 -0.11 0 1.57 0</pose>
        <geometry>
          <box>
            <size>0.1 1.2 0.05</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Gray</name>
          </script>
        </material>
      </visual>
      <collision name='base_plate_collision'>
        <pose>-0.4 0 -0.11 0 1.57 0</pose>
        <geometry>
          <box>
            <size>0.1 1.2 0.05</size>
          </box>
        </geometry>
      </collision>

      <visual name='base_plate_visual2'>
        <pose>0.4 0 -0.11 0 1.57 0</pose>
        <geometry>
          <box>
            <size>0.1 1.2 0.05</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Gray</name>
          </script>
        </material>
      </visual>
      <collision name='base_plate_collision2'>
        <pose>0.4 0 -0.11 0 1.57 0</pose>
        <geometry>
          <box>
            <size>0.1 1.2 0.05</size>
          </box>
        </geometry>
      </collision>

  <!-- Six cuboidal pillars arranged as two rows of three.
       Pillar size: 0.05 x 0.05 x 0.2 m (x, y, z).
       Positions: two rows along the X axis at x = +0.4 and x = -0.4, and
       three columns along Y at y = -0.4, 0.0 and +0.4 (see individual poses).
       Materials use Gazebo dark grey. -->
      <visual name='pillar_1_visual'>
        <pose>0.4 -0.4 0.0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 0.05 0.2</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/DarkGrey</name>
          </script>
        </material>
      </visual>
      <collision name='pillar_1_collision'>
        <pose>0.4 -0.4 0.0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 0.05 0.2</size>
          </box>
        </geometry>
      </collision>

      <visual name='pillar_2_visual'>
        <pose>0.4 0.0 0.0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 0.05 0.2</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/DarkGrey</name>
          </script>
        </material>
      </visual>
      <collision name='pillar_2_collision'>
        <pose>0.4 0.0 0.0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 0.05 0.2</size>
          </box>
        </geometry>
      </collision>

      <visual name='pillar_3_visual'>
        <pose>0.4 0.4 0.0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 0.05 0.2</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/DarkGrey</name>
          </script>
        </material>
      </visual>
      <collision name='pillar_3_collision'>
        <pose>0.4 0.4 0.0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 0.05 0.2</size>
          </box>
        </geometry>
      </collision>

  <!-- Second row of pillars (row at x = -0.4, mirrored to the first row). -->
      <visual name='pillar_4_visual'>
        <pose>-0.4 -0.4 0.0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 0.05 0.2</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/DarkGrey</name>
          </script>
        </material>
      </visual>
      <collision name='pillar_4_collision'>
        <pose>-0.4 -0.4 0.0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 0.05 0.2</size>
          </box>
        </geometry>
      </collision>

      <visual name='pillar_5_visual'>
        <pose>-0.4 0.0 0.0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 0.05 0.2</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/DarkGrey</name>
          </script>
        </material>
      </visual>
      <collision name='pillar_5_collision'>
        <pose>-0.4 0.0 0.0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 0.05 0.2</size>
          </box>
        </geometry>
      </collision>

      <visual name='pillar_6_visual'>
        <pose>-0.4 0.4 0.0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 0.05 0.2</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/DarkGrey</name>
          </script>
        </material>
      </visual>
      <collision name='pillar_6_collision'>
        <pose>-0.4 0.4 0.0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 0.05 0.2</size>
          </box>
        </geometry>
      </collision>

  <!-- Back plates (vertical plates behind the pillars).
       Two thin box plates at y = +0.6 and z offsets -0.11 and +0.05 respectively.
       Each plate is 0.05 x 1.2 x 0.05 m and uses Gazebo gray. -->
      <visual name='back_plate1_visual'>
        <pose>0 0.6 -0.11 0 0 1.57</pose>
        <geometry>
          <box>
            <size>0.05 1.2 0.05</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Gray</name>
          </script>
        </material>
      </visual>
      <collision name='back_plate1_collision'>
        <pose>0 0.6 -0.11 0 0 1.57</pose>
        <geometry>
          <box>
            <size>0.05 1.2 0.05</size>
          </box>
        </geometry>
      </collision>
      <visual name='back_plate2_visual'>
        <pose>0 0.6 0.05 0 0 1.57</pose>
        <geometry>
          <box>
            <size>0.05 1.2 0.05</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Gray</name>
          </script>
        </material>
      </visual>
      <collision name='back_plate2_collision'>
        <pose>0 0.6 0.05 0 0 1.57</pose>
        <geometry>
          <box>
            <size>0.05 1.2 0.05</size>
          </box>
        </geometry>
      </collision>

   <!-- Marker plate 1: vertical, textured plate that displays the AprilTag texture.
     The material references the AprilTag_1 model's materials/scripts and textures.
     Pose shown below places the plate near x = +0.4, y = -0.6 (see <pose>). -->
   <visual name='marker_plate'>
     <!-- Pose corresponds to the visual below (x=+0.4, y=-0.6, z=0) with rotations
       that orient the texture toward the expected camera/view direction. -->
     <pose>0.4 -0.6 0 0 3.14 1.57</pose>
        <geometry>
          <!-- thin along X, wide along Y, tall along Z -->
          <box>
            <size>0.005 0.10 0.10</size>
          </box>
        </geometry>
        <material>
  <pbr>
    <metal>
      <albedo_map>model://Apriltag36_11_00000/materials/textures/tag36_11_00000.png</albedo_map>
      <emissive_map>model://Apriltag36_11_00000/materials/textures/tag36_11_00000.png</emissive_map>
      <roughness>1.0</roughness>
      <metalness>0.0</metalness>
    </metal>
  </pbr>
</material>
      </visual>

   <!-- Marker plate 2: mirror image of marker_plate on the opposite X side.
     Uses AprilTag_2 materials and textures. Pose at x = -0.4, y = -0.6. -->
   <visual name='marker_plate2'>
     <!-- Pose corresponds to the visual below (x=-0.4, y=-0.6, z=0). -->
     <pose>-0.4 -0.6 0 0 3.14 1.57</pose>
        <geometry>
          <!-- thin along X, wide along Y, tall along Z -->
          <box>
            <size>0.005 0.10 0.10</size>
          </box>
        </geometry>
        <material>
  <pbr>
    <metal>
      <albedo_map>model://Apriltag36_11_00001/materials/textures/tag36_11_00001.png</albedo_map>
      <emissive_map>model://Apriltag36_11_00001/materials/textures/tag36_11_00001.png</emissive_map>
      <roughness>1.0</roughness>
      <metalness>0.0</metalness>
    </metal>
  </pbr>
</material>
      </visual>

   <!-- Marker plate 3: a third vertical plate centered roughly at the link origin
     (x=0) with a small downward z offset (z=-0.15). Uses AprilTag_3 textures. -->
   <visual name='marker_plate3'>
     <!-- Pose places this plate at x=0, y=0, z=-0.15 and rotates it so the texture is
       visible in the expected viewing direction. -->
     <pose>0 0 -0.15 0 3.14 1.57</pose>
        <geometry>
          <!-- thin along X, wide along Y, tall along Z -->
          <box>
            <size>0.005 0.10 0.10</size>
          </box>
        </geometry>
        <material>
  <pbr>
    <metal>
      <albedo_map>model://Apriltag36_11_00002/materials/textures/tag36_11_00002.png</albedo_map>
      <emissive_map>model://Apriltag36_11_00002/materials/textures/tag36_11_00002.png</emissive_map>
      <roughness>1.0</roughness>
      <metalness>0.0</metalness>
    </metal>
  </pbr>
</material>
      </visual>


    </link>
    <static>1</static>
  </model>
</sdf>
