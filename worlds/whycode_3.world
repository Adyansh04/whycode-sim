<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="two_whycode_world">
      
    <light name="sun_direct" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -1</direction>
    </light>
<plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
  <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
  <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
    <render_engine>ogre2</render_engine>
  </plugin>
  <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
<include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground%20Plane</uri>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun</uri>
    </include>
    <include>
      <uri>model://WhyCode_1</uri>
      <pose>3.0 0.25 0.3 0 1.57 0.0</pose>
    </include>
    <include>
      <uri>model://WhyCode_2</uri>
      <pose>3.0 -0.25 0.3 0 1.57 0.0</pose>
    </include>
    <!-- Spacer box between top and bottom markers -->
    <!-- <include> -->
      <!-- <uri>model://spacer_box</uri> -->
      <!-- <pose>3.0 0.25 0.25 0 0 0</pose> -->
    <!-- </include> -->
    <!-- Spawn two more codes exactly above these two markers -->
    <include>
      <uri>model://WhyCode_3</uri>
      <pose>3.0 0.25 0.6 0 1.57 0.0</pose>
    </include>
    <include>
      <uri>model://WhyCode_4</uri>
      <pose>3.0 -0.25 0.6 0 1.57 0.0</pose>
    </include>

  </world>
</sdf>
